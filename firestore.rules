rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasValidAvatar(userId) {
      let avatar = request.resource.data.avatar;
      let photoURL = request.resource.data.photoURL;
      return avatar is map
        && avatar.keys().hasAll(['presetId', 'storagePath', 'type'])
        && avatar.keys().hasOnly(['presetId', 'storagePath', 'type'])
        && avatar.type in ['custom', 'none', 'preset', 'provider']
        && (
          (avatar.type == 'preset'
            && avatar.presetId in ['beat', 'cherry', 'lime', 'night', 'pulse']
            && avatar.storagePath == null
            && photoURL == '/avatars/' + avatar.presetId + '.svg')
          || (avatar.type == 'custom'
            && avatar.presetId == null
            && avatar.storagePath is string
            && avatar.storagePath.matches(
              'user-avatars/' + userId
                + '/avatar-[0-9a-f-]{36}[.](jpg|png|webp)'
            )
            && photoURL is string
            && photoURL.matches(
              'https://storage.yandexcloud.net/[^/]+/' + avatar.storagePath
            ))
          || (avatar.type == 'provider'
            && avatar.presetId == null
            && avatar.storagePath == null
            && photoURL is string)
          || (avatar.type == 'none'
            && avatar.presetId == null
            && avatar.storagePath == null
            && photoURL == null)
        );
    }

    function hasValidUserProfile(userId) {
      return request.resource.data.keys().hasAll([
          'avatar',
          'createdAt',
          'displayName',
          'email',
          'onboardingCompleted',
          'photoURL',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'avatar',
          'createdAt',
          'displayName',
          'email',
          'onboardingCompleted',
          'photoURL',
          'updatedAt'
        ])
        && hasValidAvatar(userId)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 50
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.onboardingCompleted is bool
        && (request.resource.data.photoURL == null
          || (request.resource.data.photoURL is string
            && request.resource.data.photoURL.size() <= 2048))
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function hasValidCategory(category) {
      return category is map
        && category.keys().hasAll(['id', 'title'])
        && category.keys().hasOnly(['id', 'title'])
        && category.id is int
        && category.id > 0
        && category.title is string
        && category.title.size() > 0
        && category.title.size() <= 50;
    }

    function hasValidCategories() {
      let categories = request.resource.data.categories;
      return categories is list
        && categories.size() > 0
        && categories.size() <= 3
        && hasValidCategory(categories[0])
        && (categories.size() < 2 || hasValidCategory(categories[1]))
        && (categories.size() < 3 || hasValidCategory(categories[2]));
    }

    function hasValidRoom(roomId) {
      return request.resource.data.keys().hasAll([
          'categories',
          'createdAt',
          'imagePath',
          'imageUrl',
          'name',
          'ownerId',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'categories',
          'createdAt',
          'imagePath',
          'imageUrl',
          'name',
          'ownerId',
          'updatedAt'
        ])
        && hasValidCategories()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.imagePath is string
        && request.resource.data.imagePath.matches(
          'room-covers/' + roomId + '/[^/]+'
        )
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.matches(
          'https://storage.yandexcloud.net/[^/]+/room-covers/'
            + roomId + '/[^?]+'
        )
        && request.resource.data.imageUrl.size() <= 2048
        && request.resource.data.ownerId is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function hasValidPlaybackState() {
      return request.resource.data.keys().hasAll([
          'changedAt',
          'changedBy',
          'positionSeconds',
          'revision',
          'status',
          'videoId'
        ])
        && request.resource.data.keys().hasOnly([
          'changedAt',
          'changedBy',
          'positionSeconds',
          'revision',
          'status',
          'videoId'
        ])
        && request.resource.data.changedAt == request.time
        && request.resource.data.changedBy == request.auth.uid
        && request.resource.data.positionSeconds is number
        && request.resource.data.positionSeconds >= 0
        && request.resource.data.positionSeconds <= 86400
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.status in ['paused', 'playing']
        && request.resource.data.videoId is string
        && request.resource.data.videoId.size() == 11;
    }

    function hasValidQueueState() {
      let activePosition = request.resource.data.activePosition;
      let itemIds = request.resource.data.itemIds;
      let lastPosition = request.resource.data.lastPosition;
      return request.resource.data.keys().hasAll([
          'activePosition',
          'itemIds',
          'lastPosition',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'activePosition',
          'itemIds',
          'lastPosition',
          'updatedAt'
        ])
        && itemIds is list
        && itemIds.size() <= 50
        && itemIds.toSet().size() == itemIds.size()
        && (
          (itemIds.size() == 0 && activePosition == null)
          || (itemIds.size() > 0
            && activePosition is int
            && activePosition > 0
            && activePosition <= lastPosition)
        )
        && lastPosition is int
        && lastPosition >= 0
        && lastPosition <= 999999999999
        && request.resource.data.updatedAt == request.time;
    }

    function getCallerQueueItemId(roomId) {
      return get(
        /databases/$(database)/documents/rooms/$(roomId)/queueMembers/$(request.auth.uid)
      ).data.itemId;
    }

    function isQueueItemRemovedAfter(roomId, itemId) {
      return !existsAfter(
        /databases/$(database)/documents/rooms/$(roomId)/queue/$(itemId)
      );
    }

    function hasWaitingQueueItemRemoval(roomId, previousActive) {
      let itemId = getCallerQueueItemId(roomId);
      return get(
          /databases/$(database)/documents/rooms/$(roomId)/queue/$(itemId)
        ).data.position > previousActive
        && isQueueItemRemovedAfter(roomId, itemId);
    }

    function hasValidQueueStateUpdate(roomId) {
      let previousActive = resource.data.activePosition;
      let previousLast = resource.data.lastPosition;
      let previousHasItemIds = resource.data.keys().hasAll(['itemIds']);
      let previousItemCount = previousHasItemIds
        ? resource.data.itemIds.size()
        : (previousActive == null ? 0 : previousLast - previousActive + 1);
      let nextActive = request.resource.data.activePosition;
      let nextItemIds = request.resource.data.itemIds;
      let nextItemCount = nextItemIds.size();
      let appendedItemId = nextItemCount > previousItemCount
        ? nextItemIds[nextItemCount - 1]
        : '';
      let nextLast = request.resource.data.lastPosition;
      return (
          nextLast == previousLast + 1
          && nextItemCount == previousItemCount + 1
          && (
            (previousActive == null && nextActive == nextLast)
            || (previousActive != null && nextActive == previousActive)
          )
          && (!previousHasItemIds
            || nextItemIds[0:previousItemCount] == resource.data.itemIds)
          && appendedItemId is string
          && appendedItemId.matches('[0-9]{12}')
          && existsAfter(
            /databases/$(database)/documents/rooms/$(roomId)/queue/$(appendedItemId)
          )
        ) || (
          nextLast == previousLast
          && previousActive != null
          && previousItemCount > 0
          && nextItemCount == previousItemCount - 1
          && (
            (
              (
                (nextItemCount == 0 && nextActive == null)
                || (nextItemCount > 0
                  && nextActive is int
                  && nextActive > previousActive)
              )
              && (!previousHasItemIds
                || nextItemCount == 0
                || nextItemIds == resource.data.itemIds[1:previousItemCount])
              && (!previousHasItemIds
                || isQueueItemRemovedAfter(roomId, resource.data.itemIds[0]))
            )
            || (
              nextActive == previousActive
              && exists(
                /databases/$(database)/documents/rooms/$(roomId)/queueMembers/$(request.auth.uid)
              )
              && hasWaitingQueueItemRemoval(roomId, previousActive)
              && (!previousHasItemIds
                || nextItemIds == resource.data.itemIds.removeAll([
                  getCallerQueueItemId(roomId)
                ]))
            )
          )
        );
    }

    function hasInitialQueueItem(roomId) {
      let itemId = request.resource.data.itemIds[0];
      return itemId is string
        && itemId.matches('[0-9]{12}')
        && existsAfter(
          /databases/$(database)/documents/rooms/$(roomId)/queue/$(itemId)
        );
    }

    function hasValidQueueItem(roomId, itemId) {
      let profile = get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
      let queueState = getAfter(
        /databases/$(database)/documents/rooms/$(roomId)/queueState/current
      ).data;
      let queueMember = getAfter(
        /databases/$(database)/documents/rooms/$(roomId)/queueMembers/$(request.auth.uid)
      ).data;
      return request.resource.data.keys().hasAll([
          'createdAt',
          'displayName',
          'photoURL',
          'position',
          'userId',
          'videoId'
        ])
        && request.resource.data.keys().hasOnly([
          'createdAt',
          'displayName',
          'photoURL',
          'position',
          'userId',
          'videoId'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.displayName == profile.displayName
        && request.resource.data.photoURL == profile.photoURL
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.position is int
        && request.resource.data.position > 0
        && request.resource.data.position == queueState.lastPosition
        && itemId in queueState.itemIds
        && queueMember.itemId == itemId
        && queueMember.userId == request.auth.uid
        && request.resource.data.videoId is string
        && request.resource.data.videoId.matches('[-_A-Za-z0-9]{11}');
    }

    function hasValidQueueMember(roomId, memberId) {
      let queueItem = getAfter(
        /databases/$(database)/documents/rooms/$(roomId)/queue/$(request.resource.data.itemId)
      ).data;
      return request.resource.data.keys().hasAll([
          'createdAt',
          'itemId',
          'userId'
        ])
        && request.resource.data.keys().hasOnly([
          'createdAt',
          'itemId',
          'userId'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.itemId is string
        && request.resource.data.itemId.matches('[0-9]{12}')
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userId == memberId
        && queueItem.userId == request.auth.uid;
    }

    function canDeleteQueueItem(roomId, itemId) {
      let previousQueueState = get(
        /databases/$(database)/documents/rooms/$(roomId)/queueState/current
      ).data;
      let nextQueueState = getAfter(
        /databases/$(database)/documents/rooms/$(roomId)/queueState/current
      ).data;
      return !existsAfter(
          /databases/$(database)/documents/rooms/$(roomId)/queueMembers/$(resource.data.userId)
        )
        && nextQueueState.itemIds is list
        && !(itemId in nextQueueState.itemIds)
        && (request.auth.uid == resource.data.userId
          || (previousQueueState.keys().hasAll(['itemIds'])
            && previousQueueState.itemIds.size() > 0
            && previousQueueState.itemIds[0] == itemId)
          || (!previousQueueState.keys().hasAll(['itemIds'])
            && previousQueueState.activePosition == resource.data.position));
    }

    function hasValidMessage() {
      let profile = get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
      return request.resource.data.keys().hasAll([
          'authorId',
          'authorName',
          'authorPhotoURL',
          'createdAt',
          'text'
        ])
        && request.resource.data.keys().hasOnly([
          'authorId',
          'authorName',
          'authorPhotoURL',
          'createdAt',
          'text'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName == profile.displayName
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 50
        && request.resource.data.authorPhotoURL == profile.photoURL
        && (request.resource.data.authorPhotoURL == null
          || (request.resource.data.authorPhotoURL is string
            && request.resource.data.authorPhotoURL.size() <= 2048))
        && request.resource.data.createdAt == request.time
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && hasValidUserProfile(userId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(userId)
        && hasValidUserProfile(userId)
        && (request.resource.data.createdAt == resource.data.createdAt
          || (!('createdAt' in resource.data)
            && request.resource.data.createdAt == request.time))
        && (!('onboardingCompleted' in resource.data)
          || !resource.data.onboardingCompleted
          || request.resource.data.onboardingCompleted)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && hasValidRoom(roomId)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(resource.data.ownerId)
        && hasValidRoom(roomId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(resource.data.ownerId);
    }

    match /rooms/{roomId}/playback/{stateId} {
      allow read: if isSignedIn() && stateId == 'current';
      allow create: if isSignedIn()
        && stateId == 'current'
        && hasValidPlaybackState()
        && request.resource.data.revision == 1;
      allow update: if isSignedIn()
        && stateId == 'current'
        && hasValidPlaybackState()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if isSignedIn() && stateId == 'current';
    }

    match /rooms/{roomId}/queueState/{stateId} {
      allow read: if isSignedIn() && stateId == 'current';
      allow create: if isSignedIn()
        && stateId == 'current'
        && exists(/databases/$(database)/documents/rooms/$(roomId))
        && hasValidQueueState()
        && request.resource.data.activePosition == 1
        && request.resource.data.lastPosition == 1
        && request.resource.data.itemIds.size() == 1
        && hasInitialQueueItem(roomId);
      allow update: if isSignedIn()
        && stateId == 'current'
        && hasValidQueueState()
        && hasValidQueueStateUpdate(roomId);
      allow delete: if false;
    }

    match /rooms/{roomId}/queue/{itemId} {
      allow read: if isSignedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId));
      allow create: if isSignedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId))
        && itemId.matches('[0-9]{12}')
        && hasValidQueueItem(roomId, itemId);
      allow update: if false;
      allow delete: if isSignedIn() && canDeleteQueueItem(roomId, itemId);
    }

    match /rooms/{roomId}/queueMembers/{memberId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && !exists(
          /databases/$(database)/documents/rooms/$(roomId)/queueMembers/$(memberId)
        )
        && hasValidQueueMember(roomId, memberId);
      allow update: if false;
      allow delete: if isSignedIn()
        && !existsAfter(
          /databases/$(database)/documents/rooms/$(roomId)/queue/$(resource.data.itemId)
        );
    }

    match /rooms/{roomId}/messages/{messageId} {
      allow read: if isSignedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId));
      allow create: if isSignedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId))
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && hasValidMessage();
      allow update, delete: if false;
    }
  }
}
