rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasValidAvatar(userId) {
      let avatar = request.resource.data.avatar;
      let photoURL = request.resource.data.photoURL;
      return avatar is map
        && avatar.keys().hasAll(['presetId', 'storagePath', 'type'])
        && avatar.keys().hasOnly(['presetId', 'storagePath', 'type'])
        && avatar.type in ['custom', 'none', 'preset', 'provider']
        && (
          (avatar.type == 'preset'
            && avatar.presetId in ['beat', 'cherry', 'lime', 'night', 'pulse']
            && avatar.storagePath == null
            && photoURL == '/avatars/' + avatar.presetId + '.svg')
          || (avatar.type == 'custom'
            && avatar.presetId == null
            && avatar.storagePath is string
            && avatar.storagePath.matches(
              'user-avatars/' + userId
                + '/avatar-[0-9a-f-]{36}[.](jpg|png|webp)'
            )
            && photoURL is string
            && photoURL.matches(
              'https://storage.yandexcloud.net/[^/]+/' + avatar.storagePath
            ))
          || (avatar.type == 'provider'
            && avatar.presetId == null
            && avatar.storagePath == null
            && photoURL is string)
          || (avatar.type == 'none'
            && avatar.presetId == null
            && avatar.storagePath == null
            && photoURL == null)
        );
    }

    function hasValidUserProfile(userId) {
      return request.resource.data.keys().hasAll([
          'avatar',
          'createdAt',
          'displayName',
          'email',
          'onboardingCompleted',
          'photoURL',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'avatar',
          'createdAt',
          'displayName',
          'email',
          'onboardingCompleted',
          'photoURL',
          'updatedAt'
        ])
        && hasValidAvatar(userId)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 50
        && (
          (isAnonymous() && request.resource.data.email == '')
          || (!isAnonymous()
            && request.resource.data.email == request.auth.token.email)
        )
        && request.resource.data.onboardingCompleted is bool
        && (request.resource.data.photoURL == null
          || (request.resource.data.photoURL is string
            && request.resource.data.photoURL.size() <= 2048))
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function hasValidCategory(category) {
      return category is map
        && category.keys().hasAll(['id', 'title'])
        && category.keys().hasOnly(['id', 'title'])
        && category.id is int
        && category.id > 0
        && category.title is string
        && category.title.size() > 0
        && category.title.size() <= 50;
    }

    function hasValidCategories() {
      let categories = request.resource.data.categories;
      return categories is list
        && categories.size() > 0
        && categories.size() <= 3
        && hasValidCategory(categories[0])
        && (categories.size() < 2 || hasValidCategory(categories[1]))
        && (categories.size() < 3 || hasValidCategory(categories[2]));
    }

    function hasValidRoomSettings(settings) {
      return settings is map
        && settings.keys().hasAll([
          'allowGuestChat',
          'allowGuestQueue',
          'slowModeSeconds'
        ])
        && settings.keys().hasOnly([
          'allowGuestChat',
          'allowGuestQueue',
          'slowModeSeconds'
        ])
        && settings.allowGuestChat is bool
        && settings.allowGuestQueue is bool
        && settings.slowModeSeconds is int
        && settings.slowModeSeconds >= 0
        && settings.slowModeSeconds <= 300;
    }

    function hasValidRoomMemberData(member) {
      return member is map
        && member.keys().hasAll([
          'invitedBy',
          'isGuest',
          'joinedAt',
          'role',
          'status'
        ])
        && member.keys().hasOnly([
          'invitedBy',
          'isGuest',
          'joinedAt',
          'role',
          'status'
        ])
        && (member.invitedBy == null
          || (member.invitedBy is string
            && member.invitedBy.size() > 0
            && member.invitedBy.size() <= 128))
        && member.isGuest is bool
        && member.joinedAt is timestamp
        && member.role in ['host', 'member', 'moderator', 'owner']
        && member.status in ['active', 'left'];
    }

    function hasValidInitialOwnerMember(roomId) {
      let ownerMember = getAfter(
        /databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)
      ).data;
      return existsAfter(
          /databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)
        )
        && hasValidRoomMemberData(ownerMember)
        && ownerMember.invitedBy == null
        && ownerMember.isGuest == false
        && ownerMember.joinedAt == request.time
        && ownerMember.role == 'owner'
        && ownerMember.status == 'active';
    }

    function isRoomActive(room) {
      return !('status' in room) || room.status == 'active';
    }

    function isRoomOpenForDirectJoin(room) {
      return isRoomActive(room)
        && (!('visibility' in room)
          || room.visibility in ['public', 'unlisted']);
    }

    function isActiveRoomMember(roomId) {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)
        ).data.status == 'active';
    }

    function hasActiveRoomRole(roomId, roles) {
      return isActiveRoomMember(roomId)
        && get(
          /databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)
        ).data.role in roles;
    }

    function isActiveRestriction(restriction) {
      return restriction.expiresAt == null
        || restriction.expiresAt > request.time;
    }

    function isActivelyBanned(roomId, userId) {
      let banPath = /databases/$(database)/documents/rooms/$(roomId)/bans/$(userId);
      return exists(banPath) && isActiveRestriction(get(banPath).data);
    }

    function isActivelyMuted(roomId, userId) {
      let mutePath = /databases/$(database)/documents/rooms/$(roomId)/mutes/$(userId);
      return exists(mutePath) && isActiveRestriction(get(mutePath).data);
    }

    function isRoomOwnerByData(room) {
      return isSignedIn() && room.ownerId == request.auth.uid;
    }

    function canModerateRoom(roomId) {
      return hasActiveRoomRole(roomId, ['moderator', 'owner']);
    }

    function canInviteToRoom(roomId) {
      return hasActiveRoomRole(roomId, ['host', 'moderator', 'owner']);
    }

    function canAccessRoom(roomId) {
      let roomPath = /databases/$(database)/documents/rooms/$(roomId);
      let room = get(roomPath).data;
      return isSignedIn()
        && exists(roomPath)
        && !isActivelyBanned(roomId, request.auth.uid)
        && (isRoomOwnerByData(room)
          || isActiveRoomMember(roomId)
          || isRoomOpenForDirectJoin(room));
    }

    function canParticipateInRoom(roomId) {
      let roomPath = /databases/$(database)/documents/rooms/$(roomId);
      let room = get(roomPath).data;
      return canReadRoomContent(roomId)
        && isRoomActive(room)
        && (isActiveRoomMember(roomId) || isRoomOwnerByData(room));
    }

    function canReadRoomContent(roomId) {
      let roomPath = /databases/$(database)/documents/rooms/$(roomId);
      let room = get(roomPath).data;
      return isSignedIn()
        && exists(roomPath)
        && !isActivelyBanned(roomId, request.auth.uid)
        && (isRoomOwnerByData(room) || isActiveRoomMember(roomId));
    }

    function isGuestRoomMember(roomId) {
      let memberPath = /databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid);
      return exists(memberPath) && get(memberPath).data.isGuest == true;
    }

    function guestCanChat(roomId) {
      let room = get(
        /databases/$(database)/documents/rooms/$(roomId)
      ).data;
      return !isGuestRoomMember(roomId)
        || !('settings' in room)
        || room.settings.allowGuestChat == true;
    }

    function guestCanUseQueue(roomId) {
      let room = get(
        /databases/$(database)/documents/rooms/$(roomId)
      ).data;
      return !isGuestRoomMember(roomId)
        || !('settings' in room)
        || room.settings.allowGuestQueue == true;
    }

    function hasValidSelfJoinedMember(roomId, memberId) {
      let room = getAfter(
        /databases/$(database)/documents/rooms/$(roomId)
      ).data;
      let member = request.resource.data;
      return memberId == request.auth.uid
        && !isActivelyBanned(roomId, memberId)
        && existsAfter(
          /databases/$(database)/documents/rooms/$(roomId)
        )
        && hasValidRoomMemberData(member)
        && member.invitedBy == null
        && member.joinedAt == request.time
        && member.status == 'active'
        && (
          (!isAnonymous()
            && room.ownerId == request.auth.uid
            && member.isGuest == false
            && member.role == 'owner')
          || (room.ownerId != request.auth.uid
            && isRoomOpenForDirectJoin(room)
            && member.isGuest == isAnonymous()
            && member.role == 'member')
        );
    }

    function hasValidInviteJoin(roomId, memberId) {
      let redemption = getAfter(
        /databases/$(database)/documents/roomInviteRedemptions/$(memberId)
      ).data;
      let inviteBefore = get(
        /databases/$(database)/documents/roomInvites/$(redemption.inviteId)
      ).data;
      let inviteAfter = getAfter(
        /databases/$(database)/documents/roomInvites/$(redemption.inviteId)
      ).data;
      let member = request.resource.data;
      let room = getAfter(
        /databases/$(database)/documents/rooms/$(roomId)
      ).data;
      return memberId == request.auth.uid
        && isRoomActive(room)
        && !isActivelyBanned(roomId, memberId)
        && hasValidRoomMemberData(member)
        && member.invitedBy == inviteBefore.createdBy
        && member.isGuest == isAnonymous()
        && member.joinedAt == request.time
        && member.role == 'member'
        && member.status == 'active'
        && redemption.roomId == roomId
        && redemption.redeemedAt == request.time
        && inviteBefore.roomId == roomId
        && inviteBefore.revokedAt == null
        && inviteBefore.expiresAt > request.time
        && inviteBefore.uses < inviteBefore.maxUses
        && inviteAfter.uses == inviteBefore.uses + 1;
    }

    function isValidSelfLeave(memberId) {
      return memberId == request.auth.uid
        && resource.data.role != 'owner'
        && resource.data.status == 'active'
        && request.resource.data.status == 'left'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status']);
    }

    function isValidOwnerRoleChange(roomId) {
      return hasActiveRoomRole(roomId, ['owner'])
        && resource.data.role != 'owner'
        && request.resource.data.role in ['host', 'member', 'moderator']
        && (!resource.data.isGuest
          || request.resource.data.role == 'member')
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['role']);
    }

    function isValidGuestAccountUpgrade(memberId) {
      return memberId == request.auth.uid
        && !isAnonymous()
        && resource.data.isGuest == true
        && request.resource.data.isGuest == false
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isGuest']);
    }

    function hasRoomKickAuthority(roomId, memberId, memberRole) {
      let actorPath = /databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid);
      let actor = get(actorPath).data;
      return isSignedIn()
        && memberId != request.auth.uid
        && exists(actorPath)
        && actor.status == 'active'
        && (
          (actor.role == 'owner' && memberRole != 'owner')
          || (actor.role in ['host', 'moderator'] && memberRole == 'member')
        );
    }

    function isValidRoomKick(roomId, memberId) {
      let memberPath = /databases/$(database)/documents/rooms/$(roomId)/members/$(memberId);
      let memberBefore = get(memberPath).data;
      let memberAfter = getAfter(memberPath).data;
      return exists(memberPath)
        && existsAfter(memberPath)
        && hasRoomKickAuthority(roomId, memberId, memberBefore.role)
        && memberBefore.status == 'active'
        && memberAfter.status == 'left'
        && memberAfter.diff(memberBefore).affectedKeys().hasOnly(['status']);
    }

    function isValidModerationRemoval(roomId, memberId) {
      return canModerateRoom(roomId)
        && resource.data.role != 'owner'
        && resource.data.status == 'active'
        && request.resource.data.status == 'left'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status'])
        && isActivelyBannedAfter(roomId, memberId);
    }

    function isActivelyBannedAfter(roomId, userId) {
      let banPath = /databases/$(database)/documents/rooms/$(roomId)/bans/$(userId);
      return existsAfter(banPath)
        && isActiveRestriction(getAfter(banPath).data);
    }

    function hasValidRoom(roomId) {
      return request.resource.data.keys().hasAll([
          'categories',
          'createdAt',
          'imagePath',
          'imageUrl',
          'name',
          'nameKey',
          'ownerId',
          'settings',
          'status',
          'updatedAt',
          'visibility'
        ])
        && request.resource.data.keys().hasOnly([
          'categories',
          'createdAt',
          'imagePath',
          'imageUrl',
          'name',
          'nameKey',
          'ownerId',
          'settings',
          'status',
          'updatedAt',
          'visibility'
        ])
        && hasValidCategories()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.nameKey is string
        && request.resource.data.nameKey.matches('v1:[^/]+')
        && request.resource.data.nameKey.size() <= 1000
        && request.resource.data.imagePath is string
        && request.resource.data.imagePath.matches(
          'room-covers/' + roomId + '/[^/]+'
        )
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.matches(
          'https://storage.yandexcloud.net/[^/]+/room-covers/'
            + roomId + '/[^?]+'
        )
        && request.resource.data.imageUrl.size() <= 2048
        && request.resource.data.ownerId is string
        && hasValidRoomSettings(request.resource.data.settings)
        && request.resource.data.status in ['active', 'archived']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.visibility in ['private', 'public', 'unlisted']
        && existsAfter(
          /databases/$(database)/documents/roomNames/$(request.resource.data.nameKey)
        )
        && getAfter(
          /databases/$(database)/documents/roomNames/$(request.resource.data.nameKey)
        ).data.roomId == roomId
        && getAfter(
          /databases/$(database)/documents/roomNames/$(request.resource.data.nameKey)
        ).data.name == request.resource.data.name
        && getAfter(
          /databases/$(database)/documents/roomNames/$(request.resource.data.nameKey)
        ).data.ownerId == request.resource.data.ownerId;
    }

    function hasValidRoomNameReservation(roomNameId) {
      return request.resource.data.keys().hasAll([
          'createdAt',
          'name',
          'ownerId',
          'roomId'
        ])
        && request.resource.data.keys().hasOnly([
          'createdAt',
          'name',
          'ownerId',
          'roomId'
        ])
        && roomNameId.matches('v1:[^/]+')
        && roomNameId.size() <= 1000
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.roomId is string
        && request.resource.data.createdAt == request.time
        && existsAfter(
          /databases/$(database)/documents/rooms/$(request.resource.data.roomId)
        )
        && getAfter(
          /databases/$(database)/documents/rooms/$(request.resource.data.roomId)
        ).data.nameKey == roomNameId
        && getAfter(
          /databases/$(database)/documents/rooms/$(request.resource.data.roomId)
        ).data.name == request.resource.data.name
        && getAfter(
          /databases/$(database)/documents/rooms/$(request.resource.data.roomId)
        ).data.ownerId == request.resource.data.ownerId;
    }

    function hasValidPlaybackState() {
      return request.resource.data.keys().hasAll([
          'changedAt',
          'changedBy',
          'positionSeconds',
          'revision',
          'status',
          'videoId'
        ])
        && request.resource.data.keys().hasOnly([
          'changedAt',
          'changedBy',
          'positionSeconds',
          'revision',
          'status',
          'videoId'
        ])
        && request.resource.data.changedAt == request.time
        && request.resource.data.changedBy == request.auth.uid
        && request.resource.data.positionSeconds is number
        && request.resource.data.positionSeconds >= 0
        && request.resource.data.positionSeconds <= 86400
        && request.resource.data.revision is int
        && request.resource.data.revision > 0
        && request.resource.data.status in ['paused', 'playing']
        && request.resource.data.videoId is string
        && request.resource.data.videoId.size() == 11;
    }

    function hasValidQueueState() {
      let activePosition = request.resource.data.activePosition;
      let itemIds = request.resource.data.itemIds;
      let lastPosition = request.resource.data.lastPosition;
      return request.resource.data.keys().hasAll([
          'activePosition',
          'itemIds',
          'lastPosition',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'activePosition',
          'itemIds',
          'lastPosition',
          'updatedAt'
        ])
        && itemIds is list
        && itemIds.size() <= 50
        && itemIds.toSet().size() == itemIds.size()
        && (
          (itemIds.size() == 0 && activePosition == null)
          || (itemIds.size() > 0
            && activePosition is int
            && activePosition > 0
            && activePosition <= lastPosition)
        )
        && lastPosition is int
        && lastPosition >= 0
        && lastPosition <= 999999999999
        && request.resource.data.updatedAt == request.time;
    }

    function getCallerQueueItemId(roomId) {
      return get(
        /databases/$(database)/documents/rooms/$(roomId)/queueMembers/$(request.auth.uid)
      ).data.itemId;
    }

    function isQueueItemRemovedAfter(roomId, itemId) {
      return !existsAfter(
        /databases/$(database)/documents/rooms/$(roomId)/queue/$(itemId)
      );
    }

    function hasWaitingQueueItemRemoval(roomId, previousActive) {
      let itemId = getCallerQueueItemId(roomId);
      return get(
          /databases/$(database)/documents/rooms/$(roomId)/queue/$(itemId)
        ).data.position > previousActive
        && isQueueItemRemovedAfter(roomId, itemId);
    }

    function hasKickedWaitingQueueItemRemoval(
      roomId,
      previousItemIds,
      nextItemIds,
      previousActive
    ) {
      let removedItemIds = previousItemIds.removeAll(nextItemIds);
      let removedItemId = removedItemIds.size() == 1 ? removedItemIds[0] : '';
      let removedItemPath = /databases/$(database)/documents/rooms/$(roomId)/queue/$(removedItemId);
      return removedItemIds.size() == 1
        && exists(removedItemPath)
        && get(removedItemPath).data.position > previousActive
        && isQueueItemRemovedAfter(roomId, removedItemId)
        && nextItemIds == previousItemIds.removeAll([removedItemId])
        && isValidRoomKick(roomId, get(removedItemPath).data.userId);
    }

    function hasValidQueueStateUpdate(roomId) {
      let previousActive = resource.data.activePosition;
      let previousLast = resource.data.lastPosition;
      let previousHasItemIds = resource.data.keys().hasAll(['itemIds']);
      let previousItemCount = previousHasItemIds
        ? resource.data.itemIds.size()
        : (previousActive == null ? 0 : previousLast - previousActive + 1);
      let nextActive = request.resource.data.activePosition;
      let nextItemIds = request.resource.data.itemIds;
      let nextItemCount = nextItemIds.size();
      let appendedItemId = nextItemCount > previousItemCount
        ? nextItemIds[nextItemCount - 1]
        : '';
      let nextLast = request.resource.data.lastPosition;
      return (
          nextLast == previousLast + 1
          && nextItemCount == previousItemCount + 1
          && (
            (previousActive == null && nextActive == nextLast)
            || (previousActive != null && nextActive == previousActive)
          )
          && (!previousHasItemIds
            || nextItemIds[0:previousItemCount] == resource.data.itemIds)
          && appendedItemId is string
          && appendedItemId.matches('[0-9]{12}')
          && existsAfter(
            /databases/$(database)/documents/rooms/$(roomId)/queue/$(appendedItemId)
          )
        ) || (
          nextLast == previousLast
          && previousActive != null
          && previousItemCount > 0
          && nextItemCount == previousItemCount - 1
          && (
            (
              (
                (nextItemCount == 0 && nextActive == null)
                || (nextItemCount > 0
                  && nextActive is int
                  && nextActive > previousActive)
              )
              && (!previousHasItemIds
                || nextItemCount == 0
                || nextItemIds == resource.data.itemIds[1:previousItemCount])
              && (!previousHasItemIds
                || isQueueItemRemovedAfter(roomId, resource.data.itemIds[0]))
            )
            || (
              nextActive == previousActive
              && (
                (exists(
                    /databases/$(database)/documents/rooms/$(roomId)/queueMembers/$(request.auth.uid)
                  )
                  && hasWaitingQueueItemRemoval(roomId, previousActive)
                  && (!previousHasItemIds
                    || nextItemIds == resource.data.itemIds.removeAll([
                      getCallerQueueItemId(roomId)
                    ])))
                || (previousHasItemIds
                  && hasKickedWaitingQueueItemRemoval(
                    roomId,
                    resource.data.itemIds,
                    nextItemIds,
                    previousActive
                  ))
              )
            )
          )
        );
    }

    function hasInitialQueueItem(roomId) {
      let itemId = request.resource.data.itemIds[0];
      return itemId is string
        && itemId.matches('[0-9]{12}')
        && existsAfter(
          /databases/$(database)/documents/rooms/$(roomId)/queue/$(itemId)
        );
    }

    function hasValidQueueItem(roomId, itemId) {
      let profile = get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
      let queueState = getAfter(
        /databases/$(database)/documents/rooms/$(roomId)/queueState/current
      ).data;
      let queueMember = getAfter(
        /databases/$(database)/documents/rooms/$(roomId)/queueMembers/$(request.auth.uid)
      ).data;
      return request.resource.data.keys().hasAll([
          'createdAt',
          'displayName',
          'photoURL',
          'position',
          'userId',
          'videoId'
        ])
        && request.resource.data.keys().hasOnly([
          'createdAt',
          'displayName',
          'photoURL',
          'position',
          'userId',
          'videoId'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.displayName == profile.displayName
        && request.resource.data.photoURL == profile.photoURL
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.position is int
        && request.resource.data.position > 0
        && request.resource.data.position == queueState.lastPosition
        && itemId in queueState.itemIds
        && queueMember.itemId == itemId
        && queueMember.userId == request.auth.uid
        && request.resource.data.videoId is string
        && request.resource.data.videoId.matches('[-_A-Za-z0-9]{11}');
    }

    function hasValidQueueMember(roomId, memberId) {
      let queueItem = getAfter(
        /databases/$(database)/documents/rooms/$(roomId)/queue/$(request.resource.data.itemId)
      ).data;
      return request.resource.data.keys().hasAll([
          'createdAt',
          'itemId',
          'userId'
        ])
        && request.resource.data.keys().hasOnly([
          'createdAt',
          'itemId',
          'userId'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.itemId is string
        && request.resource.data.itemId.matches('[0-9]{12}')
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userId == memberId
        && queueItem.userId == request.auth.uid;
    }

    function canDeleteQueueItem(roomId, itemId) {
      let previousQueueState = get(
        /databases/$(database)/documents/rooms/$(roomId)/queueState/current
      ).data;
      let nextQueueState = getAfter(
        /databases/$(database)/documents/rooms/$(roomId)/queueState/current
      ).data;
      return !existsAfter(
          /databases/$(database)/documents/rooms/$(roomId)/queueMembers/$(resource.data.userId)
        )
        && nextQueueState.itemIds is list
        && !(itemId in nextQueueState.itemIds)
        && (request.auth.uid == resource.data.userId
          || (previousQueueState.keys().hasAll(['itemIds'])
            && previousQueueState.itemIds.size() > 0
            && previousQueueState.itemIds[0] == itemId)
          || (!previousQueueState.keys().hasAll(['itemIds'])
            && previousQueueState.activePosition == resource.data.position)
          || isValidRoomKick(roomId, resource.data.userId));
    }

    function hasValidMessage(roomId, messageId) {
      let profile = get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
      let activity = getAfter(
        /databases/$(database)/documents/rooms/$(roomId)/messageActivity/$(request.auth.uid)
      ).data;
      return request.resource.data.keys().hasAll([
          'authorId',
          'authorName',
          'authorPhotoURL',
          'createdAt',
          'text'
        ])
        && request.resource.data.keys().hasOnly([
          'authorId',
          'authorName',
          'authorPhotoURL',
          'createdAt',
          'text'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName == profile.displayName
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 50
        && request.resource.data.authorPhotoURL == profile.photoURL
        && (request.resource.data.authorPhotoURL == null
          || (request.resource.data.authorPhotoURL is string
            && request.resource.data.authorPhotoURL.size() <= 2048))
        && request.resource.data.createdAt == request.time
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && activity.lastMessageAt == request.time
        && activity.messageId == messageId;
    }

    function hasValidMessageActivity(roomId, memberId) {
      let room = get(
        /databases/$(database)/documents/rooms/$(roomId)
      ).data;
      let message = getAfter(
        /databases/$(database)/documents/rooms/$(roomId)/messages/$(request.resource.data.messageId)
      ).data;
      let configuredSlowModeSeconds = room.settings.slowModeSeconds;
      let requiredSlowModeSeconds = isGuestRoomMember(roomId)
          && configuredSlowModeSeconds < 10
        ? 10
        : configuredSlowModeSeconds;
      let respectsSlowMode = !exists(
          /databases/$(database)/documents/rooms/$(roomId)/messageActivity/$(memberId)
        ) || request.time >= resource.data.lastMessageAt
          + duration.value(requiredSlowModeSeconds, 's');
      return memberId == request.auth.uid
        && request.resource.data.keys().hasAll(['lastMessageAt', 'messageId'])
        && request.resource.data.keys().hasOnly(['lastMessageAt', 'messageId'])
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.messageId is string
        && message.authorId == request.auth.uid
        && message.createdAt == request.time
        && respectsSlowMode;
    }

    function hasValidRoomInvite() {
      return request.resource.data.keys().hasAll([
          'createdAt',
          'createdBy',
          'expiresAt',
          'maxUses',
          'revokedAt',
          'roomId',
          'uses'
        ])
        && request.resource.data.keys().hasOnly([
          'createdAt',
          'createdBy',
          'expiresAt',
          'maxUses',
          'participantCount',
          'revokedAt',
          'roomId',
          'roomImageUrl',
          'roomName',
          'uses'
        ])
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.maxUses is int
        && request.resource.data.maxUses >= 1
        && request.resource.data.maxUses <= 100
        && (request.resource.data.revokedAt == null
          || request.resource.data.revokedAt is timestamp)
        && request.resource.data.roomId is string
        && request.resource.data.uses is int
        && request.resource.data.uses >= 0
        && request.resource.data.uses <= request.resource.data.maxUses
        && (
          !request.resource.data.keys().hasAny([
            'participantCount', 'roomImageUrl', 'roomName'
          ])
          || (request.resource.data.keys().hasAll([
              'participantCount', 'roomImageUrl', 'roomName'
            ])
            && request.resource.data.participantCount is int
            && request.resource.data.participantCount >= 0
            && request.resource.data.roomImageUrl is string
            && request.resource.data.roomImageUrl.size() > 0
            && request.resource.data.roomImageUrl.size() <= 2048
            && request.resource.data.roomName is string
            && request.resource.data.roomName.size() > 0
            && request.resource.data.roomName.size() <= 80)
        );
    }

    function hasValidInviteRedemption(inviteId) {
      let member = getAfter(
        /databases/$(database)/documents/rooms/$(resource.data.roomId)/members/$(request.auth.uid)
      ).data;
      return resource.data.revokedAt == null
        && resource.data.expiresAt > request.time
        && resource.data.uses < resource.data.maxUses
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['uses'])
        && request.resource.data.uses == resource.data.uses + 1
        && existsAfter(
          /databases/$(database)/documents/roomInviteRedemptions/$(request.auth.uid)
        )
        && getAfter(
          /databases/$(database)/documents/roomInviteRedemptions/$(request.auth.uid)
        ).data.inviteId == inviteId
        && member.status == 'active'
        && member.role == 'member'
        && member.invitedBy == resource.data.createdBy
        && member.joinedAt == request.time;
    }

    function hasValidRedemptionProof(userId) {
      let redemption = request.resource.data;
      let inviteBefore = get(
        /databases/$(database)/documents/roomInvites/$(redemption.inviteId)
      ).data;
      let inviteAfter = getAfter(
        /databases/$(database)/documents/roomInvites/$(redemption.inviteId)
      ).data;
      let member = getAfter(
        /databases/$(database)/documents/rooms/$(redemption.roomId)/members/$(userId)
      ).data;
      return userId == request.auth.uid
        && redemption.keys().hasAll(['inviteId', 'redeemedAt', 'roomId'])
        && redemption.keys().hasOnly(['inviteId', 'redeemedAt', 'roomId'])
        && redemption.inviteId is string
        && redemption.redeemedAt == request.time
        && redemption.roomId is string
        && inviteBefore.roomId == redemption.roomId
        && inviteBefore.revokedAt == null
        && inviteBefore.expiresAt > request.time
        && inviteBefore.uses < inviteBefore.maxUses
        && inviteAfter.uses == inviteBefore.uses + 1
        && member.status == 'active'
        && member.role == 'member'
        && member.invitedBy == inviteBefore.createdBy
        && member.joinedAt == request.time;
    }

    function hasValidBanData(roomId, memberId) {
      let memberPath = /databases/$(database)/documents/rooms/$(roomId)/members/$(memberId);
      return request.resource.data.keys().hasAll([
          'bannedBy', 'createdAt', 'expiresAt', 'reason'
        ])
        && request.resource.data.keys().hasOnly([
          'bannedBy', 'createdAt', 'expiresAt', 'reason'
        ])
        && request.resource.data.bannedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (request.resource.data.expiresAt == null
          || (request.resource.data.expiresAt is timestamp
            && request.resource.data.expiresAt > request.time))
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && memberId != request.auth.uid
        && (!exists(memberPath) || get(memberPath).data.role != 'owner')
        && (!exists(memberPath)
          || get(memberPath).data.status != 'active'
          || getAfter(memberPath).data.status == 'left');
    }

    function hasValidMuteData(roomId, memberId) {
      let memberPath = /databases/$(database)/documents/rooms/$(roomId)/members/$(memberId);
      return request.resource.data.keys().hasAll([
          'expiresAt', 'mutedBy', 'reason'
        ])
        && request.resource.data.keys().hasOnly([
          'expiresAt', 'mutedBy', 'reason'
        ])
        && request.resource.data.mutedBy == request.auth.uid
        && (request.resource.data.expiresAt == null
          || (request.resource.data.expiresAt is timestamp
            && request.resource.data.expiresAt > request.time))
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && memberId != request.auth.uid
        && (!exists(memberPath) || get(memberPath).data.role != 'owner');
    }

    function hasValidBlockedUser(userId, blockedUserId) {
      return userId == request.auth.uid
        && blockedUserId != request.auth.uid
        && request.resource.data.keys().hasAll(['createdAt'])
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isOwner(userId)
        && hasValidUserProfile(userId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(userId)
        && hasValidUserProfile(userId)
        && (request.resource.data.createdAt == resource.data.createdAt
          || (!('createdAt' in resource.data)
            && request.resource.data.createdAt == request.time))
        && (!('onboardingCompleted' in resource.data)
          || !resource.data.onboardingCompleted
          || request.resource.data.onboardingCompleted)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /users/{userId}/blockedUsers/{blockedUserId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && hasValidBlockedUser(userId, blockedUserId);
    }

    match /rooms/{roomId} {
      allow get: if isSignedIn()
        && (!exists(/databases/$(database)/documents/rooms/$(roomId))
          || canAccessRoom(roomId));
      allow list: if isSignedIn()
        && resource.data.visibility == 'public';
      allow create: if isSignedIn()
        && !isAnonymous()
        && hasValidRoom(roomId)
        && hasValidInitialOwnerMember(roomId)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isOwner(resource.data.ownerId)
        && hasValidRoom(roomId)
        && request.resource.data.name == resource.data.name
        && request.resource.data.nameKey == resource.data.nameKey
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(resource.data.ownerId)
        && (!('nameKey' in resource.data)
          || !existsAfter(
            /databases/$(database)/documents/roomNames/$(resource.data.nameKey)
          ));
    }

    match /rooms/{roomId}/members/{memberId} {
      allow get: if (isSignedIn() && memberId == request.auth.uid)
        || canReadRoomContent(roomId);
      allow list: if canReadRoomContent(roomId);
      allow create: if isSignedIn()
        && (hasValidSelfJoinedMember(roomId, memberId)
          || hasValidInviteJoin(roomId, memberId));
      allow update: if isSignedIn()
        && hasValidRoomMemberData(request.resource.data)
        && (isValidSelfLeave(memberId)
          || (resource.data.status == 'left'
            && hasValidSelfJoinedMember(roomId, memberId))
          || (resource.data.status == 'left'
            && hasValidInviteJoin(roomId, memberId))
          || isValidGuestAccountUpgrade(memberId)
          || isValidOwnerRoleChange(roomId)
          || isValidRoomKick(roomId, memberId)
          || isValidModerationRemoval(roomId, memberId));
      allow delete: if false;
    }

    match /rooms/{roomId}/bans/{memberId} {
      allow get: if isSignedIn()
        && (memberId == request.auth.uid || canModerateRoom(roomId));
      allow list: if canModerateRoom(roomId);
      allow create, update: if canModerateRoom(roomId)
        && hasValidBanData(roomId, memberId);
      allow delete: if canModerateRoom(roomId);
    }

    match /rooms/{roomId}/mutes/{memberId} {
      allow get: if isSignedIn()
        && (memberId == request.auth.uid || canModerateRoom(roomId));
      allow list: if canModerateRoom(roomId);
      allow create, update: if canModerateRoom(roomId)
        && hasValidMuteData(roomId, memberId);
      allow delete: if canModerateRoom(roomId);
    }

    match /roomNames/{roomNameId} {
      allow get: if isSignedIn() && !isAnonymous();
      allow list: if false;
      allow create: if isSignedIn()
        && hasValidRoomNameReservation(roomNameId);
      allow update: if false;
      allow delete: if isOwner(resource.data.ownerId)
        && !existsAfter(
          /databases/$(database)/documents/rooms/$(resource.data.roomId)
        );
    }

    match /roomInvites/{inviteId} {
      // The random invite id is the bearer secret. Listing stays forbidden;
      // a direct get powers the pre-auth join preview.
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && hasValidRoomInvite()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.revokedAt == null
        && request.resource.data.uses == 0
        && canInviteToRoom(request.resource.data.roomId);
      allow update: if isSignedIn()
        && hasValidRoomInvite()
        && (hasValidInviteRedemption(inviteId)
          || (canInviteToRoom(resource.data.roomId)
            && resource.data.revokedAt == null
            && request.resource.data.revokedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['revokedAt'])));
      allow delete: if false;
    }

    match /roomInviteRedemptions/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isSignedIn()
        && hasValidRedemptionProof(userId);
      allow delete: if false;
    }

    match /rooms/{roomId}/playback/{stateId} {
      allow read: if canReadRoomContent(roomId) && stateId == 'current';
      allow create: if canParticipateInRoom(roomId)
        && stateId == 'current'
        && hasValidPlaybackState()
        && request.resource.data.revision == 1;
      allow update: if canParticipateInRoom(roomId)
        && stateId == 'current'
        && hasValidPlaybackState()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if canParticipateInRoom(roomId) && stateId == 'current';
    }

    match /rooms/{roomId}/queueState/{stateId} {
      allow read: if canReadRoomContent(roomId) && stateId == 'current';
      allow create: if canParticipateInRoom(roomId)
        && guestCanUseQueue(roomId)
        && stateId == 'current'
        && exists(/databases/$(database)/documents/rooms/$(roomId))
        && hasValidQueueState()
        && request.resource.data.activePosition == 1
        && request.resource.data.lastPosition == 1
        && request.resource.data.itemIds.size() == 1
        && hasInitialQueueItem(roomId);
      allow update: if canParticipateInRoom(roomId)
        && guestCanUseQueue(roomId)
        && stateId == 'current'
        && hasValidQueueState()
        && hasValidQueueStateUpdate(roomId);
      allow delete: if false;
    }

    match /rooms/{roomId}/queue/{itemId} {
      allow read: if canReadRoomContent(roomId)
        && exists(/databases/$(database)/documents/rooms/$(roomId));
      allow create: if canParticipateInRoom(roomId)
        && guestCanUseQueue(roomId)
        && exists(/databases/$(database)/documents/rooms/$(roomId))
        && itemId.matches('[0-9]{12}')
        && hasValidQueueItem(roomId, itemId);
      allow update: if false;
      allow delete: if canParticipateInRoom(roomId)
        && guestCanUseQueue(roomId)
        && canDeleteQueueItem(roomId, itemId);
    }

    match /rooms/{roomId}/queueMembers/{memberId} {
      allow read: if canReadRoomContent(roomId);
      allow create: if canParticipateInRoom(roomId)
        && guestCanUseQueue(roomId)
        && !exists(
          /databases/$(database)/documents/rooms/$(roomId)/queueMembers/$(memberId)
        )
        && hasValidQueueMember(roomId, memberId);
      allow update: if false;
      allow delete: if canParticipateInRoom(roomId)
        && guestCanUseQueue(roomId)
        && !existsAfter(
          /databases/$(database)/documents/rooms/$(roomId)/queue/$(resource.data.itemId)
        );
    }

    match /rooms/{roomId}/messages/{messageId} {
      allow read: if canReadRoomContent(roomId)
        && exists(/databases/$(database)/documents/rooms/$(roomId));
      allow create: if canParticipateInRoom(roomId)
        && guestCanChat(roomId)
        && !isActivelyMuted(roomId, request.auth.uid)
        && exists(/databases/$(database)/documents/rooms/$(roomId))
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && hasValidMessage(roomId, messageId);
      allow update, delete: if false;
    }

    match /rooms/{roomId}/messageActivity/{memberId} {
      allow read: if isOwner(memberId) && canReadRoomContent(roomId);
      allow create, update: if canParticipateInRoom(roomId)
        && guestCanChat(roomId)
        && !isActivelyMuted(roomId, request.auth.uid)
        && hasValidMessageActivity(roomId, memberId);
      allow delete: if false;
    }
  }
}
