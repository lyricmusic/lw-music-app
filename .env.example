# Firebase web config is public by design. Access is protected by Security Rules.
VITE_APP_ENV=development
# Technical error monitoring is production-only and disabled by default.
# A Sentry DSN is a provider-designed public client key. Never put the
# SENTRY_AUTH_TOKEN used for source-map upload in any VITE_* variable.
VITE_ERROR_MONITORING_ENABLED=false
VITE_SENTRY_DSN=https://public-key@provider.example/project-id
# Use an immutable build identifier (normally the Git commit SHA).
VITE_RELEASE=syncly-local
# Product analytics is a separate, consent-gated channel. Enabling this flag
# only shows the choice UI; Firebase Analytics loads after explicit consent.
VITE_PRODUCT_ANALYTICS_ENABLED=false
# Set true only after Enhanced Measurement is disabled in the GA4 web stream
# and the privacy checklist in docs/observability.md is complete.
VITE_PRODUCT_ANALYTICS_PRIVACY_CONFIRMED=false
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_DATABASE_URL=https://your-database-name.your-region.firebasedatabase.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
# Public reCAPTCHA Enterprise site key registered in Firebase App Check.
# Never store an App Check debug token in a Vite environment variable.
VITE_FIREBASE_APPCHECK_SITE_KEY=your-recaptcha-enterprise-site-key
# Local-only .env.local switch. This generates a token; it is not the token.
VITE_FIREBASE_APPCHECK_DEBUG=false
# HTTPS endpoint of the Yandex Cloud Function from serverless/yandex-auth.
VITE_YANDEX_AUTH_URL=https://functions.yandexcloud.net/your-auth-function-id
# HTTPS endpoint of serverless/room-invites. The function accepts a Firebase
# ID token and atomically redeems private room invitation tokens.
VITE_ROOM_INVITE_API_URL=https://functions.yandexcloud.net/your-room-invite-function-id
# HTTPS endpoint of serverless/room-management. It verifies Firebase ID tokens
# and atomically applies role, moderation, playback, and message actions.
VITE_ROOM_MANAGEMENT_API_URL=https://functions.yandexcloud.net/your-room-management-function-id
# The same authenticated Yandex Cloud function signs room covers and avatars.
VITE_MEDIA_UPLOAD_URL=https://functions.yandexcloud.net/your-function-id
