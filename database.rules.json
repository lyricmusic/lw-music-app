{
  "rules": {
    ".read": false,
    ".write": false,
    "roomPresence": {
      "$roomId": {
        ".read": "auth != null",
        "$uid": {
          "$connectionId": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber() && newData.val() <= now"
          }
        }
      }
    },
    "roomReactions": {
      "$roomId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || newData.hasChildren(['emoji', 'expiresAt'])",
          "emoji": {
            ".validate": "newData.isString() && (newData.val() === '🔥' || newData.val() === '💜' || newData.val() === '👏' || newData.val() === '✨')"
          },
          "expiresAt": {
            ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 10000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
