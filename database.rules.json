{
  "rules": {
    ".read": false,
    ".write": false,
    "roomPresence": {
      ".read": "auth != null",
      "$roomId": {
        "$uid": {
          "$connectionId": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber() && newData.val() <= now"
          }
        }
      }
    }
  }
}
