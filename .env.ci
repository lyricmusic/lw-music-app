# CI builds an optimized frontend bundle without production services or secrets.
VITE_APP_ENV=development
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-lwmusic.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-lwmusic
VITE_FIREBASE_DATABASE_URL=https://demo-lwmusic-default-rtdb.firebaseio.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:ci
VITE_FIREBASE_APPCHECK_DEBUG=false
VITE_YANDEX_AUTH_URL=https://example.invalid/yandex-auth
VITE_ROOM_INVITE_API_URL=https://example.invalid/room-invites
VITE_ROOM_MANAGEMENT_API_URL=https://example.invalid/room-management
VITE_MEDIA_UPLOAD_URL=https://example.invalid/media-upload
